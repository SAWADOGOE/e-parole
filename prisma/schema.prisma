// e-Parole — schéma Prisma (Phase 1 : fondations ; Phase 2 : Bible ; Phase 3 : réseau social et modération).
// Spécification : docs/11-DATABASE-DESIGN.md. Tables en snake_case via @@map.
// Les modèles User, Session, Account, Verification, TwoFactor et RateLimit suivent
// le schéma attendu par Better Auth 1.7 (noms de champs imposés par la bibliothèque).

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Énumérations
// ---------------------------------------------------------------------------

enum GlobalRole {
  SUPER_ADMIN
  ADMIN
  MODERATOR
  CONTENT_EDITOR
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  BANNED
  PENDING_DELETION
}

enum Visibility {
  PUBLIC
  FOLLOWERS
  COMMUNITY
  PRIVATE
}

enum VerifiedBadge {
  PASTOR
  CHURCH_LEADER
  BIBLE_TEACHER
}

enum CommunityRole {
  OWNER
  ADMIN
  MODERATOR
  MEMBER
}

enum MembershipStatus {
  PENDING
  ACTIVE
  BANNED
  LEFT
}

enum JoinPolicy {
  OPEN
  REQUEST
  INVITE_ONLY
}

enum CommunityStatus {
  ACTIVE
  SUSPENDED
}

enum MediaStatus {
  /// URL présignée émise, fichier pas encore confirmé.
  PENDING
  /// Envoi confirmé, traitement en cours dans le worker (job media.process).
  PROCESSING
  READY
  REJECTED
}

enum MediaPurpose {
  AVATAR
  BANNER
  POST_IMAGE
  COMMUNITY_IMAGE
  VERIFICATION_DOCUMENT
}

enum BibleLicense {
  PUBLIC_DOMAIN
  CC_BY
  CC_BY_SA
  LICENSED
}

enum BibleVersionStatus {
  STAGED
  ACTIVE
  RETIRED
}

enum Testament {
  OT
  NT
}

enum HighlightColor {
  YELLOW
  GREEN
  BLUE
  PINK
  PURPLE
}

enum ReaderTheme {
  SYSTEM
  LIGHT
  SEPIA
  DARK
}

enum ReaderFont {
  SERIF
  SANS
}

/// Types de publication (REQ-SOC-1). Toute publication est publique : aucune colonne de visibilité (décision du 2026-11-05).
enum PostType {
  TEXT
  TESTIMONY
  QUESTION
  MEDITATION
  ANNOUNCEMENT
}

/// Exactement trois réactions (REQ-SOC-3).
enum ReactionKind {
  AMEN
  LOVE
  ENCOURAGED
}

enum NotificationType {
  REACTION
  COMMENT
  REPLY
  MENTION
  FOLLOW
  /// Décision de modération communiquée à l'auteur.
  MODERATION
  /// Retour générique au signaleur (« Nous avons examiné… »).
  REPORT_REVIEWED
}

/// Cibles signalables en Phase 3 ; les autres (prière, communauté, message) arriveront avec leur module.
enum ReportTarget {
  POST
  COMMENT
  PROFILE
}

enum ReportReason {
  SPAM
  HARASSMENT
  HATE
  FRAUD_FINANCIAL
  IMPERSONATION
  DANGEROUS_LINK
  SEXUAL
  SELF_HARM
  MINOR_SAFETY
  OTHER
}

enum CaseStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  DISMISSED
}

/// RESTORE arrivera avec les contestations (Phase 5).
enum ModerationDecision {
  DISMISS
  WARN
  HIDE
  REMOVE
  SUSPEND
  BAN
}

enum SanctionKind {
  WARNING
  SUSPENSION
  BAN
}

// ---------------------------------------------------------------------------
// Identité et authentification (Better Auth)
// ---------------------------------------------------------------------------

model User {
  id               String        @id @default(cuid(2))
  name             String
  email            String        @unique
  emailVerified    Boolean       @default(false)
  image            String?
  twoFactorEnabled Boolean       @default(false)
  status           AccountStatus @default(ACTIVE)
  /// Fin d'une suspension (SUSPENDED) ; le worker réactive le compte à cette date.
  suspendedUntil   DateTime?
  /// Minimisation : année seulement, pour la protection des mineurs.
  birthYear        Int?
  locale           String        @default("fr")
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  deletedAt        DateTime?

  profile        Profile?
  sessions       Session[]
  accounts       Account[]
  twoFactors     TwoFactor[]
  roles          UserRole[]        @relation("UserRoles")
  grantedRoles   UserRole[]        @relation("RoleGrantedBy")
  auditLogs      AuditLog[]
  mediaAssets    MediaAsset[]
  memberships    CommunityMember[]
  settingsEdited PlatformSetting[]
  flagsEdited    FeatureFlag[]

  bibleHighlights    BibleHighlight[]
  bibleNotes         BibleNote[]
  bibleBookmarks     BibleBookmark[]
  bibleReadingState  BibleReadingState?
  dailyVersesCreated DailyVerse[]

  posts             Post[]
  comments          Comment[]
  reactions         Reaction[]
  following         Follow[]                @relation("Follower")
  followers         Follow[]                @relation("Following")
  blocking          Block[]                 @relation("Blocker")
  blockedBy         Block[]                 @relation("Blocked")
  muting            Mute[]                  @relation("Muter")
  mutedBy           Mute[]                  @relation("Muted")
  postBookmarks     PostBookmark[]
  mentions          Mention[]
  notifications     Notification[]
  notificationActs  NotificationActor[]
  notificationPrefs NotificationPreference?
  reports           Report[]
  casesTargeting    ModerationCase[]        @relation("CaseTargetAuthor")
  casesAssigned     ModerationCase[]        @relation("CaseAssignee")
  moderationActions ModerationAction[]
  sanctions         Sanction[]              @relation("SanctionTarget")
  sanctionsIssued   Sanction[]              @relation("SanctionIssuer")

  @@index([status])
  @@map("user")
}

model Session {
  id                String    @id @default(cuid(2))
  expiresAt         DateTime
  token             String    @unique
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  ipAddress         String?
  userAgent         String?
  /// Dernière ré-authentification (mot de passe) pour les actions sensibles.
  reauthenticatedAt DateTime?
  /// Second facteur vérifié POUR CETTE SESSION (TOTP ou code de secours) ; exigé par /admin.
  mfaVerifiedAt     DateTime?
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid(2))
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid(2))
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model TwoFactor {
  id                      String    @id @default(cuid(2))
  secret                  String
  backupCodes             String
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime?

  @@index([userId])
  @@index([secret])
  @@map("two_factor")
}

/// Fenêtres de limitation de débit : utilisée par Better Auth (clés d'auth)
/// et par le limiteur applicatif (clés préfixées « app: »).
model RateLimit {
  id          String @id @default(cuid(2))
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rate_limit")
}

// ---------------------------------------------------------------------------
// Profil
// ---------------------------------------------------------------------------

/// Champs sensibles : visibilité par champ PUBLIC / FOLLOWERS / PRIVATE (CHECK en SQL : jamais COMMUNITY), privés par défaut.
/// Le filtrage est fait par le repository social (src/features/social/server), jamais par l'UI.
model Profile {
  userId                 String         @id
  user                   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Unicité insensible à la casse assurée par un index sur lower(handle) (migration SQL).
  handle                 String         @unique
  handleChangedAt        DateTime?
  displayName            String         @db.VarChar(60)
  bio                    String?        @db.VarChar(280)
  avatarId               String?        @unique
  avatar                 MediaAsset?    @relation("ProfileAvatar", fields: [avatarId], references: [id], onDelete: SetNull)
  bannerId               String?        @unique
  banner                 MediaAsset?    @relation("ProfileBanner", fields: [bannerId], references: [id], onDelete: SetNull)
  churchName             String?        @db.VarChar(100)
  churchVisibility       Visibility     @default(PRIVATE)
  /// Ville : visibilité locationVisibility. Toujours PRIVATE pour un mineur (pas de géolocalisation).
  city                   String?        @db.VarChar(80)
  locationVisibility     Visibility     @default(PRIVATE)
  country                String?        @db.VarChar(60)
  countryVisibility      Visibility     @default(PRIVATE)
  denomination           String?        @db.VarChar(80)
  denominationVisibility Visibility     @default(PRIVATE)
  /// Recherche de profils et autocomplétion des mentions ; false par défaut pour un mineur.
  isDiscoverable         Boolean        @default(true)
  verifiedBadge          VerifiedBadge?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  /// Recherche de profils et mentions (pg_trgm).
  @@index([handle(ops: raw("gin_trgm_ops"))], map: "profile_handle_trgm_idx", type: Gin)
  @@map("profile")
}

// ---------------------------------------------------------------------------
// Rôles globaux (permissions définies en code : src/server/policies/permissions.ts)
// ---------------------------------------------------------------------------

model UserRole {
  userId      String
  role        GlobalRole
  grantedById String?
  grantedAt   DateTime   @default(now())
  user        User       @relation("UserRoles", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy   User?      @relation("RoleGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  @@id([userId, role])
  @@index([role])
  @@map("user_role")
}

// ---------------------------------------------------------------------------
// Communautés — socle minimal pour les rôles locaux (fonctionnalités en Phase 4)
// ---------------------------------------------------------------------------

model Community {
  id          String          @id @default(cuid(2))
  slug        String          @unique
  name        String
  description String?
  isPrivate   Boolean         @default(false)
  joinPolicy  JoinPolicy      @default(OPEN)
  status      CommunityStatus @default(ACTIVE)
  memberCount Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  deletedAt   DateTime?

  members CommunityMember[]

  @@map("community")
}

model CommunityMember {
  communityId String
  userId      String
  role        CommunityRole    @default(MEMBER)
  status      MembershipStatus @default(PENDING)
  joinedAt    DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  community   Community        @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([communityId, userId])
  @@index([userId, status])
  @@map("community_member")
}

// ---------------------------------------------------------------------------
// Administration
// ---------------------------------------------------------------------------

/// Append-only : le rôle applicatif n'a ni UPDATE ni DELETE (migration SQL).
/// metadata ne contient jamais de contenu de prière, de message, de note ni de secret.
model AuditLog {
  id         String   @id @default(cuid(2))
  actorId    String?
  /// RESTRICT : une action référentielle contournerait le REVOKE UPDATE (journal append-only).
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: Restrict)
  actorRoles String[]
  action     String
  targetType String
  targetId   String?
  metadata   Json     @default("{}")
  ip         String?
  userAgent  String?
  requestId  String?
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
  @@index([actorId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("audit_log")
}

model PlatformSetting {
  key           String   @id
  value         Json
  schemaVersion Int      @default(1)
  updatedById   String?
  updatedBy     User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt     DateTime @updatedAt

  @@map("platform_setting")
}

model FeatureFlag {
  key            String       @id
  description    String
  enabled        Boolean      @default(false)
  rolloutPercent Int          @default(0)
  allowedRoles   GlobalRole[]
  isCritical     Boolean      @default(false)
  updatedById    String?
  updatedBy      User?        @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt      DateTime     @updatedAt

  @@map("feature_flag")
}

// ---------------------------------------------------------------------------
// Médias (fichiers dans le stockage S3, métadonnées ici)
// ---------------------------------------------------------------------------

/// Pipeline ADR-004 : l'original (clé `key`, bucket privé) est supprimé après traitement ; seules les variantes
/// ré-encodées (AVIF/WebP, sans EXIF) restent, servies par l'application après contrôle d'accès (ADR-012).
model MediaAsset {
  id            String       @id @default(cuid(2))
  ownerId       String
  owner         User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  purpose       MediaPurpose
  bucket        String
  key           String       @unique
  /// MIME déclaré à la demande d'URL ; le worker le confronte aux magic bytes.
  mime          String
  /// Taille déclarée de l'original (octets, ≤ 10 Mo).
  size          Int
  width         Int?
  height        Int?
  /// SHA-256 de l'original (contrôle d'intégrité, détection de doublons).
  sha256        String?
  /// Variantes produites : [{ width, height, format, key, bytes }].
  variants      Json         @default("[]")
  /// Couleur dominante (#rrggbb) affichée en attendant l'image.
  dominantColor String?
  /// Code de refus (MAGIC_MISMATCH, UNSUPPORTED_FORMAT, TOO_LARGE, DECODE_FAILED…) : jamais de contenu.
  errorCode     String?
  status        MediaStatus  @default(PENDING)
  isPublic      Boolean      @default(false)
  uploadedAt    DateTime?
  processedAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  avatarOf  Profile?   @relation("ProfileAvatar")
  bannerOf  Profile?   @relation("ProfileBanner")
  postMedia PostMedia?

  @@index([ownerId, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@map("media_asset")
}

// ---------------------------------------------------------------------------
// Réseau social (Phase 3) — règles d'accès appliquées dans src/features/social/server (ADR-011)
// ---------------------------------------------------------------------------

/// Toujours publique (visible par tout membre connecté), sauf pour un compte bloqué dans un sens ou dans l'autre.
/// Le verset cité est une référence (coordonnées) ; son texte est rendu depuis bible_verse, jamais recopié.
model Post {
  id                  String    @id @default(cuid(2))
  authorId            String
  type                PostType  @default(TEXT)
  body                String    @default("") @db.VarChar(5000)
  verseTranslationId  Int?
  verseBookId         String?
  verseChapter        Int?
  verseStart          Int?
  verseEnd            Int?
  /// Masqué par la modération (décision ou masquage provisoire à 5 signalements) ; l'auteur le voit avec une mention.
  isHidden            Boolean   @default(false)
  hiddenAt            DateTime?
  commentsLocked      Boolean   @default(false)
  /// deletedAt posé par la modération (« Retirer ») plutôt que par l'auteur.
  removedByModeration Boolean   @default(false)
  amenCount           Int       @default(0)
  loveCount           Int       @default(0)
  encouragedCount     Int       @default(0)
  /// Commentaires visibles (ni supprimés ni masqués), tous niveaux.
  commentCount        Int       @default(0)
  editedAt            DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  author           User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  verseTranslation BibleTranslation? @relation(fields: [verseTranslationId], references: [id], onDelete: Restrict)
  verseBook        BibleBook?        @relation(fields: [verseBookId], references: [id], onDelete: Restrict)
  media            PostMedia[]
  comments         Comment[]
  reactions        Reaction[]
  mentions         Mention[]
  bookmarks        PostBookmark[]

  @@index([authorId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@map("post")
}

model PostMedia {
  postId   String
  assetId  String     @unique
  position Int
  /// Texte alternatif saisi par l'auteur (WCAG 1.1.1).
  altText  String     @default("") @db.VarChar(300)
  post     Post       @relation(fields: [postId], references: [id], onDelete: Cascade)
  asset    MediaAsset @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@id([postId, position])
  @@map("post_media")
}

/// Un seul niveau de réponse : parentId désigne toujours un commentaire de premier niveau (vérifié par le service et un trigger).
model Comment {
  id                  String    @id @default(cuid(2))
  postId              String
  authorId            String
  parentId            String?
  body                String    @db.VarChar(2000)
  /// Masqué par la modération.
  isHidden            Boolean   @default(false)
  /// Masqué par l'auteur de la publication : visible seulement par son propre auteur.
  hiddenByPostAuthor  Boolean   @default(false)
  removedByModeration Boolean   @default(false)
  amenCount           Int       @default(0)
  loveCount           Int       @default(0)
  encouragedCount     Int       @default(0)
  replyCount          Int       @default(0)
  editedAt            DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  post      Post       @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent    Comment?   @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[]  @relation("CommentReplies")
  reactions Reaction[]
  mentions  Mention[]

  @@index([postId, parentId, createdAt, id])
  @@index([authorId, createdAt(sort: Desc)])
  @@map("comment")
}

/// Une réaction par personne et par cible, modifiable (CHECK num_nonnulls(postId, commentId) = 1 en SQL).
model Reaction {
  id        String       @id @default(cuid(2))
  userId    String
  postId    String?
  commentId String?
  kind      ReactionKind
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post    Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@unique([userId, commentId])
  @@index([postId])
  @@index([commentId])
  @@map("reaction")
}

model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId, createdAt(sort: Desc)])
  @@map("follow")
}

/// Le blocage est symétrique dans ses effets : aucun des deux ne voit l'autre. Jamais notifié.
model Block {
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
  @@map("block")
}

/// Mise en sourdine : retire des fils et des notifications du membre qui l'a posée, sans rien changer pour l'autre.
model Mute {
  muterId   String
  mutedId   String
  createdAt DateTime @default(now())
  muter     User     @relation("Muter", fields: [muterId], references: [id], onDelete: Cascade)
  muted     User     @relation("Muted", fields: [mutedId], references: [id], onDelete: Cascade)

  @@id([muterId, mutedId])
  @@map("mute")
}

/// Favori d'une publication (distinct de BibleBookmark), strictement privé.
model PostBookmark {
  userId    String
  postId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("post_bookmark")
}

/// Mention résolue à l'écriture (blocage et découvrabilité vérifiés). handle = forme écrite dans le texte.
model Mention {
  id        String   @id @default(cuid(2))
  postId    String?
  commentId String?
  userId    String
  handle    String   @db.VarChar(30)
  createdAt DateTime @default(now())
  post      Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@unique([commentId, userId])
  @@index([userId])
  @@map("mention")
}

// ---------------------------------------------------------------------------
// Notifications in-app (REQ-NOTIF-1, ADR-013) : une ligne par groupe, acteurs distincts dans notification_actor.
// Un seul groupe non lu par (destinataire, groupKey) : index unique partiel en SQL.
// ---------------------------------------------------------------------------

model Notification {
  id          String           @id @default(cuid(2))
  recipientId String
  type        NotificationType
  /// Clé de regroupement, ex. « reaction:post:<id> » ; jamais de contenu.
  groupKey    String           @db.VarChar(120)
  postId      String?
  commentId   String?
  /// Données de la notification de modération (décision, date de fin, motif communiqué). Vide sinon.
  data        Json             @default("{}")
  readAt      DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  recipient User                @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  actors    NotificationActor[]

  @@index([recipientId, updatedAt(sort: Desc), id(sort: Desc)])
  @@map("notification")
}

model NotificationActor {
  notificationId String
  actorId        String
  createdAt      DateTime     @default(now())
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  actor          User         @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@id([notificationId, actorId])
  @@index([actorId])
  @@map("notification_actor")
}

/// Préférences in-app par type ; absence de ligne = tout activé.
model NotificationPreference {
  userId    String   @id
  reaction  Boolean  @default(true)
  comment   Boolean  @default(true)
  reply     Boolean  @default(true)
  mention   Boolean  @default(true)
  follow    Boolean  @default(true)
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preference")
}

// ---------------------------------------------------------------------------
// Modération v1 (US-41, docs/admin/ADMIN-MODERATION.md)
// ---------------------------------------------------------------------------

/// Un dossier ouvert par cible (index unique partiel en SQL sur les statuts OPEN et IN_PROGRESS).
model ModerationCase {
  id                 String       @id @default(cuid(2))
  targetType         ReportTarget
  targetId           String
  /// Auteur de la cible au premier signalement (contexte de modération uniquement).
  targetAuthorId     String?
  targetAuthorMinor  Boolean      @default(false)
  status             CaseStatus   @default(OPEN)
  /// 0 critique … 3 faible (docs/20).
  priority           Int          @default(2)
  dominantReason     ReportReason
  reportCount        Int          @default(0)
  /// Signalements de comptes de plus de 7 jours : 5 déclenchent le masquage provisoire.
  trustedReportCount Int          @default(0)
  assigneeId         String?
  autoHiddenAt       DateTime?
  resolvedAt         DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  targetAuthor User?              @relation("CaseTargetAuthor", fields: [targetAuthorId], references: [id], onDelete: SetNull)
  assignee     User?              @relation("CaseAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reports      Report[]
  actions      ModerationAction[]
  sanctions    Sanction[]

  @@index([status, priority, createdAt])
  @@index([targetType, targetId])
  @@index([targetAuthorId, createdAt(sort: Desc)])
  @@map("moderation_case")
}

/// evidenceSnapshot : copie figée de la cible au moment du signalement (seule donnée vue par la modération).
model Report {
  id               String       @id @default(cuid(2))
  reporterId       String
  caseId           String
  targetType       ReportTarget
  targetId         String
  reason           ReportReason
  details          String?      @db.VarChar(1000)
  evidenceSnapshot Json
  /// Compte du signaleur âgé de plus de 7 jours au moment du signalement.
  reporterTrusted  Boolean      @default(false)
  createdAt        DateTime     @default(now())

  reporter User           @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  case     ModerationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([reporterId, targetType, targetId])
  @@index([caseId, createdAt])
  @@map("report")
}

/// Historique des décisions : append-only pour le rôle applicatif (migration SQL).
model ModerationAction {
  id           String             @id @default(cuid(2))
  caseId       String
  moderatorId  String
  decision     ModerationDecision
  /// Motif communiqué à l'auteur.
  publicReason String             @db.VarChar(500)
  /// Note interne, visible des seuls modérateurs ; jamais copiée dans l'audit.
  internalNote String?            @db.VarChar(1000)
  durationDays Int?
  createdAt    DateTime           @default(now())

  case      ModerationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  moderator User           @relation(fields: [moderatorId], references: [id], onDelete: Restrict)
  sanctions Sanction[]

  @@index([caseId, createdAt])
  @@map("moderation_action")
}

model Sanction {
  id         String       @id @default(cuid(2))
  userId     String
  kind       SanctionKind
  caseId     String?
  actionId   String?
  issuedById String
  startsAt   DateTime     @default(now())
  endsAt     DateTime?
  createdAt  DateTime     @default(now())

  user     User              @relation("SanctionTarget", fields: [userId], references: [id], onDelete: Cascade)
  issuedBy User              @relation("SanctionIssuer", fields: [issuedById], references: [id], onDelete: Restrict)
  case     ModerationCase?   @relation(fields: [caseId], references: [id], onDelete: SetNull)
  action   ModerationAction? @relation(fields: [actionId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@map("sanction")
}

// ---------------------------------------------------------------------------
// Bible — données de référence (docs/bible/BIBLE-DATABASE-SCHEMA.md)
// Le rôle applicatif n'a que SELECT sur ces tables ; l'écriture passe par le rôle
// eparole_bible_import (migration SQL). Aucune clé étrangère vers "user" : un TRUNCATE
// ou une purge de comptes ne doit jamais pouvoir atteindre le texte biblique.
// ---------------------------------------------------------------------------

model BibleTranslation {
  id                Int          @id @default(autoincrement())
  code              String       @unique
  name              String
  language          String
  licenseType       BibleLicense
  licenseUrl        String
  /// Texte affiché partout où un verset apparaît.
  attribution       String
  sourceUrl         String
  sourceRetrievedAt DateTime
  /// Référence de l'archive datée de la page de licence (hors dépôt).
  licenseEvidence   String
  isPublished       Boolean      @default(false)
  activeVersionId   Int?         @unique
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  activeVersion BibleTranslationVersion?  @relation("ActiveVersion", fields: [activeVersionId], references: [id], onDelete: Restrict)
  versions      BibleTranslationVersion[] @relation("TranslationVersions")
  highlights    BibleHighlight[]
  notes         BibleNote[]
  bookmarks     BibleBookmark[]
  readingStates BibleReadingState[]
  dailyVerses   DailyVerse[]
  posts         Post[]

  @@map("bible_translation")
}

model BibleTranslationVersion {
  id                Int                @id @default(autoincrement())
  translationId     Int
  sourceProvider    String
  /// SHA-256 du fichier source tel que téléchargé.
  sourceSha256      String
  sourceRetrievedAt DateTime
  /// SHA-256 global, calculé sur les versets normalisés dans l'ordre canonique.
  checksum          String
  bookCount         Int
  chapterCount      Int
  verseCount        Int
  /// Libellé de l'opérateur de la CLI (pas une clé étrangère : voir l'en-tête de section).
  importedBy        String
  importedAt        DateTime           @default(now())
  activatedAt       DateTime?
  status            BibleVersionStatus @default(STAGED)
  /// Rapport d'intégrité : écarts de versification, éléments ignorés, contrôle croisé.
  report            Json               @default("{}")

  translation  BibleTranslation   @relation("TranslationVersions", fields: [translationId], references: [id], onDelete: Restrict)
  activeFor    BibleTranslation?  @relation("ActiveVersion")
  verses       BibleVerse[]
  chapterMetas BibleChapterMeta[]

  @@index([translationId, status])
  @@map("bible_translation_version")
}

model BibleBook {
  /// Code USFM indépendant de la langue (GEN … REV).
  id           String    @id
  order        Int       @unique
  testament    Testament
  chapterCount Int

  names        BibleBookName[]
  verses       BibleVerse[]
  chapterMetas BibleChapterMeta[]
  highlights   BibleHighlight[]
  notes        BibleNote[]
  bookmarks    BibleBookmark[]
  dailyVerses  DailyVerse[]
  poolEntries  DailyVersePool[]
  posts        Post[]

  @@index([testament, order])
  @@map("bible_book")
}

model BibleBookName {
  bookId        String
  language      String
  name          String
  /// Slug canonique de l'URL (« 1-corinthiens »).
  slug          String
  /// Formes reconnues par le parseur, en minuscules et sans accents.
  abbreviations String[]

  book BibleBook @relation(fields: [bookId], references: [id], onDelete: Restrict)

  @@id([bookId, language])
  @@unique([language, slug])
  @@map("bible_book_name")
}

/// Un chapitre n'est pas une table : ceci dénormalise le nombre de versets par chapitre.
model BibleChapterMeta {
  versionId  Int
  bookId     String
  chapter    Int
  verseCount Int

  version BibleTranslationVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
  book    BibleBook               @relation(fields: [bookId], references: [id], onDelete: Restrict)

  @@id([versionId, bookId, chapter])
  @@map("bible_chapter_meta")
}

model BibleVerse {
  id        Int                      @id @default(autoincrement())
  versionId Int
  bookId    String
  chapter   Int
  verse     Int
  text      String
  /// SHA-256 du texte normalisé.
  checksum  String
  /// Colonne générée (migration SQL). dbgenerated décrit son expression pour que Prisma ne la voie pas comme un écart.
  search    Unsupported("tsvector")? @default(dbgenerated("bible_fts_vector(text)"))

  version BibleTranslationVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
  book    BibleBook               @relation(fields: [bookId], references: [id], onDelete: Restrict)

  @@unique([versionId, bookId, chapter, verse])
  @@index([search], map: "bible_verse_search_idx", type: Gin)
  @@map("bible_verse")
}

// ---------------------------------------------------------------------------
// Bible — données utilisateur : coordonnées, jamais BibleVerse.id, pour survivre à un
// nouvel import. Les notes sont strictement privées (permission bible_note:read = jamais).
// ---------------------------------------------------------------------------

model BibleHighlight {
  id            String         @id @default(cuid(2))
  userId        String
  translationId Int
  bookId        String
  chapter       Int
  verseStart    Int
  verseEnd      Int
  color         HighlightColor
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  translation BibleTranslation @relation(fields: [translationId], references: [id], onDelete: Restrict)
  book        BibleBook        @relation(fields: [bookId], references: [id], onDelete: Restrict)

  @@index([userId, translationId, bookId, chapter])
  @@index([userId, createdAt(sort: Desc), id])
  @@map("bible_highlight")
}

model BibleNote {
  id            String   @id @default(cuid(2))
  userId        String
  translationId Int
  bookId        String
  chapter       Int
  verseStart    Int
  verseEnd      Int
  body          String   @db.VarChar(5000)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  translation BibleTranslation @relation(fields: [translationId], references: [id], onDelete: Restrict)
  book        BibleBook        @relation(fields: [bookId], references: [id], onDelete: Restrict)

  @@index([userId, translationId, bookId, chapter])
  @@index([userId, createdAt(sort: Desc), id])
  @@map("bible_note")
}

model BibleBookmark {
  id            String   @id @default(cuid(2))
  userId        String
  translationId Int
  bookId        String
  chapter       Int
  verseStart    Int
  verseEnd      Int
  createdAt     DateTime @default(now())

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  translation BibleTranslation @relation(fields: [translationId], references: [id], onDelete: Restrict)
  book        BibleBook        @relation(fields: [bookId], references: [id], onDelete: Restrict)

  @@unique([userId, translationId, bookId, chapter, verseStart, verseEnd])
  @@index([userId, createdAt(sort: Desc), id])
  @@map("bible_bookmark")
}

model BibleReadingState {
  userId           String      @id
  translationId    Int?
  bookId           String?
  chapter          Int?
  fontSize         Int         @default(19)
  lineHeight       Float       @default(1.7)
  theme            ReaderTheme @default(SYSTEM)
  font             ReaderFont  @default(SERIF)
  showVerseNumbers Boolean     @default(true)
  /// Date du dernier choix de réglages ; null tant que seule la position de lecture a été enregistrée.
  prefsSetAt       DateTime?
  updatedAt        DateTime    @updatedAt

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  translation BibleTranslation? @relation(fields: [translationId], references: [id], onDelete: Restrict)

  @@map("bible_reading_state")
}

/// Un verset par jour. Le texte n'est jamais recopié : il est rendu depuis bible_verse.
model DailyVerse {
  id            String   @id @default(cuid(2))
  date          DateTime @unique @db.Date
  translationId Int
  bookId        String
  chapter       Int
  verseStart    Int
  verseEnd      Int
  /// Phrase éditoriale, séparée du texte biblique.
  reflection    String?  @db.VarChar(200)
  /// Sélection automatique depuis daily_verse_pool (aucun éditeur).
  isAutomatic   Boolean  @default(false)
  scheduledById String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  translation BibleTranslation @relation(fields: [translationId], references: [id], onDelete: Restrict)
  book        BibleBook        @relation(fields: [bookId], references: [id], onDelete: Restrict)
  scheduledBy User?            @relation(fields: [scheduledById], references: [id], onDelete: SetNull)

  @@index([bookId, chapter, verseStart])
  @@map("daily_verse")
}

/// Liste curatée de références (aucun texte) pour les jours non programmés.
model DailyVersePool {
  id         Int     @id @default(autoincrement())
  bookId     String
  chapter    Int
  verseStart Int
  verseEnd   Int
  isActive   Boolean @default(true)

  book BibleBook @relation(fields: [bookId], references: [id], onDelete: Restrict)

  @@unique([bookId, chapter, verseStart, verseEnd])
  @@map("daily_verse_pool")
}
