// e-Parole — schéma Prisma (Phase 1 : fondations ; Phase 2 : Bible).
// Spécification : docs/11-DATABASE-DESIGN.md. Tables en snake_case via @@map.
// Les modèles User, Session, Account, Verification, TwoFactor et RateLimit suivent
// le schéma attendu par Better Auth 1.7 (noms de champs imposés par la bibliothèque).

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Énumérations
// ---------------------------------------------------------------------------

enum GlobalRole {
  SUPER_ADMIN
  ADMIN
  MODERATOR
  CONTENT_EDITOR
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  BANNED
  PENDING_DELETION
}

enum Visibility {
  PUBLIC
  FOLLOWERS
  COMMUNITY
  PRIVATE
}

enum VerifiedBadge {
  PASTOR
  CHURCH_LEADER
  BIBLE_TEACHER
}

enum CommunityRole {
  OWNER
  ADMIN
  MODERATOR
  MEMBER
}

enum MembershipStatus {
  PENDING
  ACTIVE
  BANNED
  LEFT
}

enum JoinPolicy {
  OPEN
  REQUEST
  INVITE_ONLY
}

enum CommunityStatus {
  ACTIVE
  SUSPENDED
}

enum MediaStatus {
  PENDING
  READY
  REJECTED
}

enum MediaPurpose {
  AVATAR
  BANNER
  POST_IMAGE
  COMMUNITY_IMAGE
  VERIFICATION_DOCUMENT
}

enum BibleLicense {
  PUBLIC_DOMAIN
  CC_BY
  CC_BY_SA
  LICENSED
}

enum BibleVersionStatus {
  STAGED
  ACTIVE
  RETIRED
}

enum Testament {
  OT
  NT
}

enum HighlightColor {
  YELLOW
  GREEN
  BLUE
  PINK
  PURPLE
}

enum ReaderTheme {
  SYSTEM
  LIGHT
  SEPIA
  DARK
}

enum ReaderFont {
  SERIF
  SANS
}

// ---------------------------------------------------------------------------
// Identité et authentification (Better Auth)
// ---------------------------------------------------------------------------

model User {
  id               String        @id @default(cuid(2))
  name             String
  email            String        @unique
  emailVerified    Boolean       @default(false)
  image            String?
  twoFactorEnabled Boolean       @default(false)
  status           AccountStatus @default(ACTIVE)
  /// Minimisation : année seulement, pour la protection des mineurs.
  birthYear        Int?
  locale           String        @default("fr")
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  deletedAt        DateTime?

  profile        Profile?
  sessions       Session[]
  accounts       Account[]
  twoFactors     TwoFactor[]
  roles          UserRole[]        @relation("UserRoles")
  grantedRoles   UserRole[]        @relation("RoleGrantedBy")
  auditLogs      AuditLog[]
  mediaAssets    MediaAsset[]
  memberships    CommunityMember[]
  settingsEdited PlatformSetting[]
  flagsEdited    FeatureFlag[]

  bibleHighlights    BibleHighlight[]
  bibleNotes         BibleNote[]
  bibleBookmarks     BibleBookmark[]
  bibleReadingState  BibleReadingState?
  dailyVersesCreated DailyVerse[]

  @@index([status])
  @@map("user")
}

model Session {
  id                String    @id @default(cuid(2))
  expiresAt         DateTime
  token             String    @unique
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  ipAddress         String?
  userAgent         String?
  /// Dernière ré-authentification (mot de passe) pour les actions sensibles.
  reauthenticatedAt DateTime?
  /// Second facteur vérifié POUR CETTE SESSION (TOTP ou code de secours) ; exigé par /admin.
  mfaVerifiedAt     DateTime?
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid(2))
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid(2))
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model TwoFactor {
  id                      String    @id @default(cuid(2))
  secret                  String
  backupCodes             String
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime?

  @@index([userId])
  @@index([secret])
  @@map("two_factor")
}

/// Fenêtres de limitation de débit : utilisée par Better Auth (clés d'auth)
/// et par le limiteur applicatif (clés préfixées « app: »).
model RateLimit {
  id          String @id @default(cuid(2))
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rate_limit")
}

// ---------------------------------------------------------------------------
// Profil
// ---------------------------------------------------------------------------

model Profile {
  userId                 String         @id
  user                   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Unicité insensible à la casse assurée par un index sur lower(handle) (migration SQL).
  handle                 String         @unique
  displayName            String
  bio                    String?        @db.VarChar(280)
  avatarId               String?
  bannerId               String?
  churchName             String?
  churchVisibility       Visibility     @default(PRIVATE)
  city                   String?
  locationVisibility     Visibility     @default(PRIVATE)
  denomination           String?
  denominationVisibility Visibility     @default(PRIVATE)
  isDiscoverable         Boolean        @default(true)
  verifiedBadge          VerifiedBadge?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  @@map("profile")
}

// ---------------------------------------------------------------------------
// Rôles globaux (permissions définies en code : src/server/policies/permissions.ts)
// ---------------------------------------------------------------------------

model UserRole {
  userId      String
  role        GlobalRole
  grantedById String?
  grantedAt   DateTime   @default(now())
  user        User       @relation("UserRoles", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy   User?      @relation("RoleGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  @@id([userId, role])
  @@index([role])
  @@map("user_role")
}

// ---------------------------------------------------------------------------
// Communautés — socle minimal pour les rôles locaux (fonctionnalités en Phase 4)
// ---------------------------------------------------------------------------

model Community {
  id          String          @id @default(cuid(2))
  slug        String          @unique
  name        String
  description String?
  isPrivate   Boolean         @default(false)
  joinPolicy  JoinPolicy      @default(OPEN)
  status      CommunityStatus @default(ACTIVE)
  memberCount Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  deletedAt   DateTime?

  members CommunityMember[]

  @@map("community")
}

model CommunityMember {
  communityId String
  userId      String
  role        CommunityRole    @default(MEMBER)
  status      MembershipStatus @default(PENDING)
  joinedAt    DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  community   Community        @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([communityId, userId])
  @@index([userId, status])
  @@map("community_member")
}

// ---------------------------------------------------------------------------
// Administration
// ---------------------------------------------------------------------------

/// Append-only : le rôle applicatif n'a ni UPDATE ni DELETE (migration SQL).
/// metadata ne contient jamais de contenu de prière, de message, de note ni de secret.
model AuditLog {
  id         String   @id @default(cuid(2))
  actorId    String?
  /// RESTRICT : une action référentielle contournerait le REVOKE UPDATE (journal append-only).
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: Restrict)
  actorRoles String[]
  action     String
  targetType String
  targetId   String?
  metadata   Json     @default("{}")
  ip         String?
  userAgent  String?
  requestId  String?
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
  @@index([actorId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("audit_log")
}

model PlatformSetting {
  key           String   @id
  value         Json
  schemaVersion Int      @default(1)
  updatedById   String?
  updatedBy     User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt     DateTime @updatedAt

  @@map("platform_setting")
}

model FeatureFlag {
  key            String       @id
  description    String
  enabled        Boolean      @default(false)
  rolloutPercent Int          @default(0)
  allowedRoles   GlobalRole[]
  isCritical     Boolean      @default(false)
  updatedById    String?
  updatedBy      User?        @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt      DateTime     @updatedAt

  @@map("feature_flag")
}

// ---------------------------------------------------------------------------
// Médias (fichiers dans le stockage S3, métadonnées ici)
// ---------------------------------------------------------------------------

model MediaAsset {
  id        String       @id @default(cuid(2))
  ownerId   String
  owner     User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  purpose   MediaPurpose
  bucket    String
  key       String       @unique
  mime      String
  size      Int
  width     Int?
  height    Int?
  sha256    String?
  status    MediaStatus  @default(PENDING)
  isPublic  Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([ownerId, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@map("media_asset")
}

// ---------------------------------------------------------------------------
// Bible — données de référence (docs/bible/BIBLE-DATABASE-SCHEMA.md)
// Le rôle applicatif n'a que SELECT sur ces tables ; l'écriture passe par le rôle
// eparole_bible_import (migration SQL). Aucune clé étrangère vers "user" : un TRUNCATE
// ou une purge de comptes ne doit jamais pouvoir atteindre le texte biblique.
// ---------------------------------------------------------------------------

model BibleTranslation {
  id                Int          @id @default(autoincrement())
  code              String       @unique
  name              String
  language          String
  licenseType       BibleLicense
  licenseUrl        String
  /// Texte affiché partout où un verset apparaît.
  attribution       String
  sourceUrl         String
  sourceRetrievedAt DateTime
  /// Référence de l'archive datée de la page de licence (hors dépôt).
  licenseEvidence   String
  isPublished       Boolean      @default(false)
  activeVersionId   Int?         @unique
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  activeVersion BibleTranslationVersion?  @relation("ActiveVersion", fields: [activeVersionId], references: [id], onDelete: Restrict)
  versions      BibleTranslationVersion[] @relation("TranslationVersions")
  highlights    BibleHighlight[]
  notes         BibleNote[]
  bookmarks     BibleBookmark[]
  readingStates BibleReadingState[]
  dailyVerses   DailyVerse[]

  @@map("bible_translation")
}

model BibleTranslationVersion {
  id                Int                @id @default(autoincrement())
  translationId     Int
  sourceProvider    String
  /// SHA-256 du fichier source tel que téléchargé.
  sourceSha256      String
  sourceRetrievedAt DateTime
  /// SHA-256 global, calculé sur les versets normalisés dans l'ordre canonique.
  checksum          String
  bookCount         Int
  chapterCount      Int
  verseCount        Int
  /// Libellé de l'opérateur de la CLI (pas une clé étrangère : voir l'en-tête de section).
  importedBy        String
  importedAt        DateTime           @default(now())
  activatedAt       DateTime?
  status            BibleVersionStatus @default(STAGED)
  /// Rapport d'intégrité : écarts de versification, éléments ignorés, contrôle croisé.
  report            Json               @default("{}")

  translation  BibleTranslation   @relation("TranslationVersions", fields: [translationId], references: [id], onDelete: Restrict)
  activeFor    BibleTranslation?  @relation("ActiveVersion")
  verses       BibleVerse[]
  chapterMetas BibleChapterMeta[]

  @@index([translationId, status])
  @@map("bible_translation_version")
}

model BibleBook {
  /// Code USFM indépendant de la langue (GEN … REV).
  id           String    @id
  order        Int       @unique
  testament    Testament
  chapterCount Int

  names        BibleBookName[]
  verses       BibleVerse[]
  chapterMetas BibleChapterMeta[]
  highlights   BibleHighlight[]
  notes        BibleNote[]
  bookmarks    BibleBookmark[]
  dailyVerses  DailyVerse[]
  poolEntries  DailyVersePool[]

  @@index([testament, order])
  @@map("bible_book")
}

model BibleBookName {
  bookId        String
  language      String
  name          String
  /// Slug canonique de l'URL (« 1-corinthiens »).
  slug          String
  /// Formes reconnues par le parseur, en minuscules et sans accents.
  abbreviations String[]

  book BibleBook @relation(fields: [bookId], references: [id], onDelete: Restrict)

  @@id([bookId, language])
  @@unique([language, slug])
  @@map("bible_book_name")
}

/// Un chapitre n'est pas une table : ceci dénormalise le nombre de versets par chapitre.
model BibleChapterMeta {
  versionId  Int
  bookId     String
  chapter    Int
  verseCount Int

  version BibleTranslationVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
  book    BibleBook               @relation(fields: [bookId], references: [id], onDelete: Restrict)

  @@id([versionId, bookId, chapter])
  @@map("bible_chapter_meta")
}

model BibleVerse {
  id        Int                      @id @default(autoincrement())
  versionId Int
  bookId    String
  chapter   Int
  verse     Int
  text      String
  /// SHA-256 du texte normalisé.
  checksum  String
  /// Colonne générée (migration SQL) : bible_fts_vector(text).
  search    Unsupported("tsvector")?

  version BibleTranslationVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
  book    BibleBook               @relation(fields: [bookId], references: [id], onDelete: Restrict)

  @@unique([versionId, bookId, chapter, verse])
  @@index([search], map: "bible_verse_search_idx", type: Gin)
  @@map("bible_verse")
}

// ---------------------------------------------------------------------------
// Bible — données utilisateur : coordonnées, jamais BibleVerse.id, pour survivre à un
// nouvel import. Les notes sont strictement privées (permission bible_note:read = jamais).
// ---------------------------------------------------------------------------

model BibleHighlight {
  id            String         @id @default(cuid(2))
  userId        String
  translationId Int
  bookId        String
  chapter       Int
  verseStart    Int
  verseEnd      Int
  color         HighlightColor
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  translation BibleTranslation @relation(fields: [translationId], references: [id], onDelete: Restrict)
  book        BibleBook        @relation(fields: [bookId], references: [id], onDelete: Restrict)

  @@index([userId, translationId, bookId, chapter])
  @@index([userId, createdAt(sort: Desc), id])
  @@map("bible_highlight")
}

model BibleNote {
  id            String   @id @default(cuid(2))
  userId        String
  translationId Int
  bookId        String
  chapter       Int
  verseStart    Int
  verseEnd      Int
  body          String   @db.VarChar(5000)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  translation BibleTranslation @relation(fields: [translationId], references: [id], onDelete: Restrict)
  book        BibleBook        @relation(fields: [bookId], references: [id], onDelete: Restrict)

  @@index([userId, translationId, bookId, chapter])
  @@index([userId, createdAt(sort: Desc), id])
  @@map("bible_note")
}

model BibleBookmark {
  id            String   @id @default(cuid(2))
  userId        String
  translationId Int
  bookId        String
  chapter       Int
  verseStart    Int
  verseEnd      Int
  createdAt     DateTime @default(now())

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  translation BibleTranslation @relation(fields: [translationId], references: [id], onDelete: Restrict)
  book        BibleBook        @relation(fields: [bookId], references: [id], onDelete: Restrict)

  @@unique([userId, translationId, bookId, chapter, verseStart, verseEnd])
  @@index([userId, createdAt(sort: Desc), id])
  @@map("bible_bookmark")
}

model BibleReadingState {
  userId           String      @id
  translationId    Int?
  bookId           String?
  chapter          Int?
  fontSize         Int         @default(19)
  lineHeight       Float       @default(1.7)
  theme            ReaderTheme @default(SYSTEM)
  font             ReaderFont  @default(SERIF)
  showVerseNumbers Boolean     @default(true)
  /// Date du dernier choix de réglages ; null tant que seule la position de lecture a été enregistrée.
  prefsSetAt       DateTime?
  updatedAt        DateTime    @updatedAt

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  translation BibleTranslation? @relation(fields: [translationId], references: [id], onDelete: Restrict)

  @@map("bible_reading_state")
}

/// Un verset par jour. Le texte n'est jamais recopié : il est rendu depuis bible_verse.
model DailyVerse {
  id            String   @id @default(cuid(2))
  date          DateTime @unique @db.Date
  translationId Int
  bookId        String
  chapter       Int
  verseStart    Int
  verseEnd      Int
  /// Phrase éditoriale, séparée du texte biblique.
  reflection    String?  @db.VarChar(200)
  /// Sélection automatique depuis daily_verse_pool (aucun éditeur).
  isAutomatic   Boolean  @default(false)
  scheduledById String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  translation BibleTranslation @relation(fields: [translationId], references: [id], onDelete: Restrict)
  book        BibleBook        @relation(fields: [bookId], references: [id], onDelete: Restrict)
  scheduledBy User?            @relation(fields: [scheduledById], references: [id], onDelete: SetNull)

  @@index([bookId, chapter, verseStart])
  @@map("daily_verse")
}

/// Liste curatée de références (aucun texte) pour les jours non programmés.
model DailyVersePool {
  id         Int     @id @default(autoincrement())
  bookId     String
  chapter    Int
  verseStart Int
  verseEnd   Int
  isActive   Boolean @default(true)

  book BibleBook @relation(fields: [bookId], references: [id], onDelete: Restrict)

  @@unique([bookId, chapter, verseStart, verseEnd])
  @@map("daily_verse_pool")
}
