// e-Parole — schéma Prisma (Phase 1 : fondations).
// Spécification : docs/11-DATABASE-DESIGN.md. Tables en snake_case via @@map.
// Les modèles User, Session, Account, Verification, TwoFactor et RateLimit suivent
// le schéma attendu par Better Auth 1.7 (noms de champs imposés par la bibliothèque).

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Énumérations
// ---------------------------------------------------------------------------

enum GlobalRole {
  SUPER_ADMIN
  ADMIN
  MODERATOR
  CONTENT_EDITOR
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  BANNED
  PENDING_DELETION
}

enum Visibility {
  PUBLIC
  FOLLOWERS
  COMMUNITY
  PRIVATE
}

enum VerifiedBadge {
  PASTOR
  CHURCH_LEADER
  BIBLE_TEACHER
}

enum CommunityRole {
  OWNER
  ADMIN
  MODERATOR
  MEMBER
}

enum MembershipStatus {
  PENDING
  ACTIVE
  BANNED
  LEFT
}

enum JoinPolicy {
  OPEN
  REQUEST
  INVITE_ONLY
}

enum CommunityStatus {
  ACTIVE
  SUSPENDED
}

enum MediaStatus {
  PENDING
  READY
  REJECTED
}

enum MediaPurpose {
  AVATAR
  BANNER
  POST_IMAGE
  COMMUNITY_IMAGE
  VERIFICATION_DOCUMENT
}

// ---------------------------------------------------------------------------
// Identité et authentification (Better Auth)
// ---------------------------------------------------------------------------

model User {
  id               String        @id @default(cuid(2))
  name             String
  email            String        @unique
  emailVerified    Boolean       @default(false)
  image            String?
  twoFactorEnabled Boolean       @default(false)
  status           AccountStatus @default(ACTIVE)
  /// Minimisation : année seulement, pour la protection des mineurs.
  birthYear        Int?
  locale           String        @default("fr")
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  deletedAt        DateTime?

  profile        Profile?
  sessions       Session[]
  accounts       Account[]
  twoFactors     TwoFactor[]
  roles          UserRole[]        @relation("UserRoles")
  grantedRoles   UserRole[]        @relation("RoleGrantedBy")
  auditLogs      AuditLog[]
  mediaAssets    MediaAsset[]
  memberships    CommunityMember[]
  settingsEdited PlatformSetting[]
  flagsEdited    FeatureFlag[]

  @@index([status])
  @@map("user")
}

model Session {
  id                String    @id @default(cuid(2))
  expiresAt         DateTime
  token             String    @unique
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  ipAddress         String?
  userAgent         String?
  /// Dernière ré-authentification (mot de passe) pour les actions sensibles.
  reauthenticatedAt DateTime?
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid(2))
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid(2))
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model TwoFactor {
  id                      String    @id @default(cuid(2))
  secret                  String
  backupCodes             String
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime?

  @@index([userId])
  @@index([secret])
  @@map("two_factor")
}

/// Fenêtres de limitation de débit : utilisée par Better Auth (clés d'auth)
/// et par le limiteur applicatif (clés préfixées « app: »).
model RateLimit {
  id          String @id @default(cuid(2))
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rate_limit")
}

// ---------------------------------------------------------------------------
// Profil
// ---------------------------------------------------------------------------

model Profile {
  userId                 String         @id
  user                   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Unicité insensible à la casse assurée par un index sur lower(handle) (migration SQL).
  handle                 String         @unique
  displayName            String
  bio                    String?        @db.VarChar(280)
  avatarId               String?
  bannerId               String?
  churchName             String?
  churchVisibility       Visibility     @default(PRIVATE)
  city                   String?
  locationVisibility     Visibility     @default(PRIVATE)
  denomination           String?
  denominationVisibility Visibility     @default(PRIVATE)
  isDiscoverable         Boolean        @default(true)
  verifiedBadge          VerifiedBadge?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  @@map("profile")
}

// ---------------------------------------------------------------------------
// Rôles globaux (permissions définies en code : src/server/policies/permissions.ts)
// ---------------------------------------------------------------------------

model UserRole {
  userId      String
  role        GlobalRole
  grantedById String?
  grantedAt   DateTime   @default(now())
  user        User       @relation("UserRoles", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy   User?      @relation("RoleGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  @@id([userId, role])
  @@index([role])
  @@map("user_role")
}

// ---------------------------------------------------------------------------
// Communautés — socle minimal pour les rôles locaux (fonctionnalités en Phase 4)
// ---------------------------------------------------------------------------

model Community {
  id          String          @id @default(cuid(2))
  slug        String          @unique
  name        String
  description String?
  isPrivate   Boolean         @default(false)
  joinPolicy  JoinPolicy      @default(OPEN)
  status      CommunityStatus @default(ACTIVE)
  memberCount Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  deletedAt   DateTime?

  members CommunityMember[]

  @@map("community")
}

model CommunityMember {
  communityId String
  userId      String
  role        CommunityRole    @default(MEMBER)
  status      MembershipStatus @default(PENDING)
  joinedAt    DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  community   Community        @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([communityId, userId])
  @@index([userId, status])
  @@map("community_member")
}

// ---------------------------------------------------------------------------
// Administration
// ---------------------------------------------------------------------------

/// Append-only : le rôle applicatif n'a ni UPDATE ni DELETE (migration SQL).
/// metadata ne contient jamais de contenu de prière, de message, de note ni de secret.
model AuditLog {
  id         String   @id @default(cuid(2))
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorRoles String[]
  action     String
  targetType String
  targetId   String?
  metadata   Json     @default("{}")
  ip         String?
  userAgent  String?
  requestId  String?
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
  @@index([actorId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("audit_log")
}

model PlatformSetting {
  key           String   @id
  value         Json
  schemaVersion Int      @default(1)
  updatedById   String?
  updatedBy     User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt     DateTime @updatedAt

  @@map("platform_setting")
}

model FeatureFlag {
  key            String       @id
  description    String
  enabled        Boolean      @default(false)
  rolloutPercent Int          @default(0)
  allowedRoles   GlobalRole[]
  isCritical     Boolean      @default(false)
  updatedById    String?
  updatedBy      User?        @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt      DateTime     @updatedAt

  @@map("feature_flag")
}

// ---------------------------------------------------------------------------
// Médias (fichiers dans le stockage S3, métadonnées ici)
// ---------------------------------------------------------------------------

model MediaAsset {
  id        String       @id @default(cuid(2))
  ownerId   String
  owner     User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  purpose   MediaPurpose
  bucket    String
  key       String       @unique
  mime      String
  size      Int
  width     Int?
  height    Int?
  sha256    String?
  status    MediaStatus  @default(PENDING)
  isPublic  Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([ownerId, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@map("media_asset")
}
