# Copier en .env puis remplacer chaque CHANGE_ME par une valeur générée localement.
# Ne jamais committer .env. Ports : convention « port standard précédé de 5 ».

APP_URL=http://localhost:53000
WEB_PORT=53000
APP_ENV=development

# PostgreSQL (db)
POSTGRES_DB=eparole
POSTGRES_TEST_DB=eparole_test
POSTGRES_OWNER_USER=eparole_owner
POSTGRES_OWNER_PASSWORD=CHANGE_ME
# Nom imposé : les migrations retirent les droits sensibles à ce rôle précis, et le démarrage le vérifie.
POSTGRES_APP_USER=eparole_app
POSTGRES_APP_PASSWORD=CHANGE_ME
DB_PORT=55432
# Rôle applicatif (sans SUPERUSER) pour l'application et le worker
DATABASE_URL=postgresql://eparole_app:CHANGE_ME@127.0.0.1:55432/eparole
# Rôle propriétaire, utilisé uniquement par Prisma Migrate et le seed
MIGRATION_DATABASE_URL=postgresql://eparole_owner:CHANGE_ME@127.0.0.1:55432/eparole
TEST_DATABASE_URL=postgresql://eparole_owner:CHANGE_ME@127.0.0.1:55432/eparole_test

# Better Auth
BETTER_AUTH_SECRET=CHANGE_ME_32_BYTES_MIN
BETTER_AUTH_URL=http://localhost:53000

# Stockage S3 (SeaweedFS en dev)
S3_ENDPOINT=http://127.0.0.1:58333
S3_PORT=58333
# Adresse du stockage vue par le navigateur pour les URL présignées (par défaut S3_ENDPOINT).
S3_PUBLIC_ENDPOINT=http://127.0.0.1:58333
S3_REGION=us-east-1
S3_BUCKET_PUBLIC=eparole-public
S3_BUCKET_PRIVATE=eparole-private
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME

# Email (Mailpit en dev)
SMTP_HOST=127.0.0.1
SMTP_PORT=51025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="e-Parole <no-reply@eparole.local>"
MAIL_UI_PORT=58025
MAILPIT_API_URL=http://127.0.0.1:58025

# Seed : compte SUPER_ADMIN local (dev uniquement)
SEED_SUPER_ADMIN_EMAIL=admin@eparole.local
SEED_SUPER_ADMIN_PASSWORD=CHANGE_ME_LONG_PASSWORD
SEED_SUPER_ADMIN_NAME="Administrateur e-Parole"

LOG_LEVEL=info
